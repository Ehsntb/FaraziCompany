DirectoryIndex index.html
Options -Indexes
RewriteEngine On

# Deny internal directories before the public page routing rules.
RewriteRule ^(?:scripts|private)(?:/|$) - [F,L,NC]

# Protect dotfiles/directories, but allow certificate verification paths.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

# PHP can still read these files locally; only HTTP access is denied.
<FilesMatch "(?i)^(?:seo-config\.json|README\.md|SEO-NOTES\.md|AGENTS\.md|router\.php)$">
    Require all denied
</FilesMatch>

# Public pages and the gallery endpoint must remain accessible.
RewriteRule ^$ site.php?page=index.html [END]
RewriteRule ^((?:index|about|products|contact|lame-yarn|fancy-yarn)(?:\.en)?\.html|sitemap\.xml|robots\.txt)$ site.php?page=$1 [END]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
